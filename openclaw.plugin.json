{
  "id": "deterministic-router",
  "name": "Deterministic Router",
  "description": "Local, auditable model routing for OpenClaw with shadow-first rollout.",
  "activation": {
    "onStartup": false,
    "onCapabilities": [
      "hook"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "mode": {
        "type": "string",
        "enum": [
          "off",
          "shadow",
          "auto"
        ],
        "default": "shadow",
        "description": "off disables routing; shadow logs decisions without overriding; auto applies overrides."
      },
      "ambiguousTier": {
        "type": "string",
        "enum": [
          "SIMPLE",
          "MEDIUM",
          "COMPLEX",
          "REASONING"
        ],
        "default": "COMPLEX"
      },
      "protectManualSelection": {
        "type": "boolean",
        "default": true
      },
      "requireSessionKeyForAuto": {
        "type": "boolean",
        "default": true
      },
      "autoSessionKeyHashes": {
        "type": "array",
        "description": "SHA-256 hex digests of exact session keys permitted to receive AUTO overrides. With no parent grants, an empty list makes AUTO inert.",
        "items": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "default": []
      },
      "autoSpawnParentGrants": {
        "type": "array",
        "description": "Explicit parent-incarnation grants for first-turn AUTO routing of verified same-agent direct subagents. Empty disables this path.",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["parentSessionKeyHash", "parentSessionId", "parentLifecycleRevision", "parentCreatorProfileId"],
          "properties": {
            "parentSessionKeyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "parentSessionId": { "type": "string", "minLength": 1 },
            "parentLifecycleRevision": { "type": "string", "minLength": 1 },
            "parentCreatorProfileId": { "type": "string", "minLength": 1 }
          }
        },
        "default": []
      },
      "minAttachmentTier": {
        "type": "string",
        "enum": [
          "SIMPLE",
          "MEDIUM",
          "COMPLEX",
          "REASONING"
        ],
        "default": "MEDIUM"
      },
      "models": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "SIMPLE": {
            "$ref": "#/$defs/modelTarget"
          },
          "MEDIUM": {
            "$ref": "#/$defs/modelTarget"
          },
          "COMPLEX": {
            "$ref": "#/$defs/modelTarget"
          },
          "REASONING": {
            "$ref": "#/$defs/modelTarget"
          }
        }
      },
      "stageRouting": {
        "type": "object",
        "additionalProperties": false,
        "description": "Opt-in stage callback controls; independently route model and reasoning effort. Existing experimental environment enablement and AUTO safeguards still apply.",
        "properties": {
          "model": {
            "type": "boolean",
            "default": true
          },
          "effort": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "$defs": {
      "modelTarget": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "model"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "categories": [
    "developer-tools"
  ]
}
