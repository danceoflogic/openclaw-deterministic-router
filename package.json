{
  "name": "@danceoflogic/openclaw-deterministic-router",
  "version": "0.1.0",
  "description": "Deterministic, local model routing for OpenClaw with auditable per-turn policy and shadow-first rollout.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.6 <2027",
      "minGatewayVersion": "2026.9.6"
    },
    "build": {
      "openclawVersion": "2026.9.8",
      "pluginSdkVersion": "2026.9.8"
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "acceptance:operator": "node scripts/acceptance/cli.mjs",
    "test:acceptance:operator": "node --test scripts/acceptance/*.test.mjs"
  },
  "keywords": [
    "openclaw",
    "llm",
    "model-routing",
    "deterministic-routing",
    "ai-agents",
    "cost-optimization",
    "router"
  ],
  "author": "Chris Davison",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danceoflogic/openclaw-deterministic-router.git"
  },
  "bugs": {
    "url": "https://github.com/danceoflogic/openclaw-deterministic-router/issues"
  },
  "homepage": "https://github.com/danceoflogic/openclaw-deterministic-router#readme",
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.6 <2027"
  },
  "dependencies": {
    "@blockrun/router-core": "github:BlockRunAI/router-core#5ee7c23c993013a8052588191569db5cf7fb793c"
  },
  "devDependencies": {
    "openclaw": "2026.9.8",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "@openclaw/gateway-client": "2026.10.4",
    "@openclaw/gateway-protocol": "2026.10.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "npm@11.6.0"
}
