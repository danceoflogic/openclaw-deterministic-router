@@ -0,0 +1,62 @@
+use std::sync::Weak;
+
+use anyhow::Context;
+use codex_app_server_protocol::ServerRequestPayload;
+use codex_app_server_protocol::StageRoutingParams;
+use codex_app_server_protocol::StageRoutingResponse;
+use codex_core::StageRouter;
+use codex_protocol::ThreadId;
+
+use crate::outgoing_message::OutgoingMessageSender;
+use crate::thread_state::ThreadStateManager;
+
+pub(crate) struct AppServerStageRouter {
+    pub outgoing: Weak<OutgoingMessageSender>,
+    pub threads: ThreadStateManager,
+}
+
+impl StageRouter for AppServerStageRouter {
+    fn route(
+        &self,
+        thread_id: ThreadId,
+        turn_id: String,
+        model: String,
+        next_objective: Option<String>,
+    ) -> std::pin::Pin<
+        Box<dyn std::future::Future<Output = anyhow::Result<Option<String>>> + Send + '_>,
+    > {
+        Box::pin(async move {
+            let outgoing = self
+                .outgoing
+                .upgrade()
+                .context("stage routing transport closed")?;
+            let connections = self.threads.subscribed_connection_ids(thread_id).await;
+            anyhow::ensure!(
+                connections.len() == 1,
+                "stage routing requires exactly one subscribed owner"
+            );
+            let (id, response) = outgoing
+                .send_request_to_connections(
+                    Some(&connections),
+                    ServerRequestPayload::StageRouting(StageRoutingParams {
+                        thread_id: thread_id.to_string(),
+                        turn_id,
+                        model,
+                        next_objective,
+                    }),
+                    Some(thread_id),
+                )
+                .await;
+            let result = tokio::time::timeout(std::time::Duration::from_secs(5), response).await;
+            match result {
+                Ok(Ok(Ok(value))) => {
+                    Ok(serde_json::from_value::<StageRoutingResponse>(value)?.model)
+                }
+                _ => {
+                    let _ = outgoing.cancel_request(&id).await;
+                    anyhow::bail!("stage routing answer unavailable; no model change applied")
+                }
+            }
+        })
+    }
+}
