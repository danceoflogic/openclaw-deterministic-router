+//! Opt-in host handoff at a completed response/tool-batch boundary.
+use std::future::Future;
+use std::pin::Pin;
+use std::sync::Arc;
+
+use codex_protocol::ThreadId;
+
+/// Host-owned routing, not a model tool. Returning no model retains settings.
+pub trait StageRouter: Send + Sync {
+    fn route(
+        &self,
+        thread_id: ThreadId,
+        turn_id: String,
+        model: String,
+        next_objective: Option<String>,
+    ) -> Pin<Box<dyn Future<Output = anyhow::Result<Option<String>>> + Send + '_>>;
+}
+
+/// Thread attachment supplied only by a host that implements the protocol.
+#[derive(Clone)]
+pub(crate) struct StageRoutingHandler(pub Arc<dyn StageRouter>);
+
+/// Latest accepted plan; scoped to the turn and read only after its tools drain.
+pub(crate) struct StageRoutingObjective(pub Option<String>);
