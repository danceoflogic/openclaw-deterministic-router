+use crate::JsonSchema;
+use crate::TS;
+use serde::Deserialize;
+use serde::Serialize;
+use codex_protocol::openai_models::ReasoningEffort;
+
+/// Sent only after the response and its complete tool batch settle, before capture.
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct StageRoutingParams {
+    pub thread_id: String,
+    pub turn_id: String,
+    pub model: String,
+    pub next_objective: Option<String>,
+    pub effort: Option<ReasoningEffort>,
+    pub supported_efforts: Vec<ReasoningEffort>,
+}
+
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+#[ts(export_to = "v2/")]
+pub struct StageRoutingResponse {
+    /// Omission retains the current model. Native validation is never bypassed.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(optional)]
+    pub model: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(optional)]
+    pub effort: Option<ReasoningEffort>,
+}
