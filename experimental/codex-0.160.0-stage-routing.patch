index 0000000..6999b60
--- /dev/null
+++ b/codex-rs/core/src/session/stage_routing.rs
@@ -0,0 +1,60 @@
+use std::sync::Arc;
+
+use codex_async_utils::OrCancelExt;
+use codex_features::Feature;
+use codex_protocol::error::Result as CodexResult;
+use codex_protocol::protocol::TurnSettingsUpdate;
+use tokio_util::sync::CancellationToken;
+
+use super::session::Session;
+use super::turn_context::TurnContext;
+use crate::stage_routing::StageRoutingHandler;
+use crate::stage_routing::StageRoutingObjective;
+
+pub(super) async fn route_completed_stage(
+    session: &Arc<Session>,
+    turn: &Arc<TurnContext>,
+    cancellation: &CancellationToken,
+) -> CodexResult<()> {
+    if !session.features.enabled(Feature::StepModelSwitching) {
+        return Ok(());
+    }
+    let Some(handler) = session
+        .services
+        .thread_extension_data
+        .get::<StageRoutingHandler>()
+    else {
+        return Ok(());
+    };
+    let objective = turn
+        .extension_data
+        .get::<StageRoutingObjective>()
+        .and_then(|state| state.0.clone());
+    let model = turn.capture_current_model_info().slug.clone();
+    let started = std::time::Instant::now();
+    let selected = handler
+        .0
+        .route(
+            session.thread_id,
+            turn.sub_id.clone(),
+            model.clone(),
+            objective,
+        )
+        .or_cancel(cancellation)
+        .await?;
+    match selected {
+        Ok(Some(next)) if next != model => {
+            let _ = cancellation.clone().run_until_cancelled(async {
+                let outcome = session.apply_turn_settings(&turn.sub_id, TurnSettingsUpdate {
+                    model: Some(next.clone()), ..Default::default()
+                }).await;
+                tracing::info!(turn_id = %turn.sub_id, from = %model, to = %next, ?outcome, elapsed_ms = started.elapsed().as_secs_f64() * 1000.0, "stage routing settings outcome");
+            }).await;
+        }
+        Err(error) => {
+            tracing::warn!(%error, "stage routing unavailable; retaining current settings")
+        }
+        Ok(_) => {}
+    }
+    Ok(())
+}
