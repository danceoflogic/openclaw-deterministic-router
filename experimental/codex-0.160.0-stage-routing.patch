new file mode 100644
--- /dev/null
+++ b/codex-rs/core/src/session/stage_routing.rs
@@ -0,0 +1,69 @@
+use std::sync::Arc;
+
+use codex_async_utils::OrCancelExt;
+use codex_features::Feature;
+use codex_protocol::error::Result as CodexResult;
+use codex_protocol::protocol::TurnSettingsUpdate;
+use tokio_util::sync::CancellationToken;
+
+use super::session::Session;
+use super::turn_context::TurnContext;
+use crate::stage_routing::StageRoutingHandler;
+use crate::stage_routing::StageRoutingObjective;
+
+pub(super) async fn route_completed_stage(
+    session: &Arc<Session>,
+    turn: &Arc<TurnContext>,
+    cancellation: &CancellationToken,
+) -> CodexResult<()> {
+    if !session.features.enabled(Feature::StepModelSwitching) {
+        return Ok(());
+    }
+    let Some(handler) = session
+        .services
+        .thread_extension_data
+        .get::<StageRoutingHandler>()
+    else {
+        return Ok(());
+    };
+    let objective = turn
+        .extension_data
+        .get::<StageRoutingObjective>()
+        .and_then(|state| state.0.clone());
+    let settings = turn.next_step_settings.load_full();
+    let model = settings.model_info.slug.clone();
+    let effort = settings.effective_reasoning_effort();
+    let supported_efforts: Vec<_> = settings.model_info.supported_reasoning_levels.iter().map(|level| level.effort.clone()).collect();
+    let started = std::time::Instant::now();
+    let selected = handler
+        .0
+        .route(
+            session.thread_id,
+            turn.sub_id.clone(),
+            model.clone(),
+            objective,
+            effort.clone(),
+            supported_efforts.clone(),
+        )
+        .or_cancel(cancellation)
+        .await?;
+    match selected {
+        Ok(next) => {
+            let next_model = next.model.filter(|value| value != &model);
+            // Only send supported levels; native settings/managed policy remain authoritative.
+            let next_effort = next.effort.filter(|value| Some(value.clone()) != effort && supported_efforts.contains(value));
+            if next_model.is_some() || next_effort.is_some() {
+                let _ = cancellation.clone().run_until_cancelled(async {
+                    let outcome = session.apply_turn_settings(&turn.sub_id, TurnSettingsUpdate {
+                        model: next_model.clone(), effort: next_effort.clone().map(Some), ..Default::default()
+                    }).await;
+                    tracing::info!(turn_id = %turn.sub_id, from = %model, to = %next_model.as_ref().unwrap_or(&model),
+                        from_effort = ?effort, to_effort = ?next_effort, ?outcome,
+                        elapsed_ms = started.elapsed().as_secs_f64() * 1000.0, "stage routing settings outcome");
+                }).await;
+            }
+        }
+        Err(error) => tracing::warn!(%error, "stage routing unavailable; retaining current settings"),
+    }
+    Ok(())
+}
